{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Output contract",
  "type": "object",
  "required": ["task_id", "required_files"],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "required_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "required_metrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}

