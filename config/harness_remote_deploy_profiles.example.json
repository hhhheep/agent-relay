{
  "schema_version": 1,
  "profiles": {
    "EXAMPLE": {
      "binding_id": "EXAMPLE_WORKPLACE",
      "host": "user@example.invalid",
      "solution_agent_root": "/opt/solution-agent",
      "project_workdir": "/work/example",
      "remote_run_root": "/work/example/.solution-agent/runs",
      "codex_path": "codex",
      "python_bootstrap": "python3",
      "plugin_home": "/work/example/.plugins",
      "personal_marketplace": "/work/example/marketplace.json",
      "provider_env_file": "/work/example/credentials.local.env",
      "initialize_checkout": false,
      "jobs": {
        "backend": "systemd_transient",
        "max_concurrent": 1
      },
      "bootstrap": {
        "mode": "existing_checkout"
      },
      "remote_terminals": {
        "hub_name": "solution-agent-hub",
        "default": "main",
        "max_children": 8,
        "segment_bytes": 4194304,
        "retain_segments": 16,
        "slots": {
          "main": {
            "window_name": "interactive-main",
            "cwd": "/work/example",
            "shell": "/bin/bash"
          }
        }
      }
    }
  }
}
